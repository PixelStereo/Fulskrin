# ThreadSanitizer suppressions (TSAN_OPTIONS=suppressions=test/tsan.supp).
# Only libraries not built with ThreadSanitizer: their own synchronization (futexes, atomics, thread pools) is
# invisible to it, so the memory and the mutexes they recycle between their threads look like races. Pinol's own
# code is never suppressed: a report with Pinol on both sides fails the job.
called_from_lib:libQt6Core
called_from_lib:libQt6Gui
# Mesa is loaded and unloaded at run time (dlopen): called_from_lib would abort at exit ("library ... is
# unloaded"), so its reports are matched by module instead
race:libgallium*
mutex:libgallium*
called_from_lib:libavcodec
called_from_lib:libavutil
# GLib (pulled in by Qt's platform and network code): its "gdbus" thread frees memory that the main thread
# allocated, synchronized by GLib's own futex-based mutexes. Matched by module, like Mesa (GIO can be loaded at
# run time)
race:libglib-2.0.so*
race:libgio-2.0.so*
mutex:libglib-2.0.so*
mutex:libgio-2.0.so*
